{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://boost-gram-bot.onrender.com/api/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors https://web.telegram.org https://*.telegram.org https://telegram.org" }
    ] }
  ]
}
